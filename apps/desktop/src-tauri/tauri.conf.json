{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leaves",
  "version": "0.1.1",
  "identifier": "com.leaves.desktop",
  "build": {
    "beforeDevCommand": "../../scripts/build_backend.sh && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "../../scripts/build_backend.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leaves",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/leaves-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private personal context, on your device",
    "longDescription": "Leaves brings your personal context together and keeps it on your device."
  }
}
